{
  "expo": {
    "name": "ViSignAR",
    "slug": "web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ViSignAR cần quyền truy cập camera để hiển thị ngôn ngữ ký hiệu trong không gian thực (AR).",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSMicrophoneUsageDescription": "ViSignAR cần microphone để nhận dạng giọng nói tiếng Việt.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.ViSignAR"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ],
      "package": "com.anonymous.ViSignAR",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "visignar",
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "ViSignAR cần quyền truy cập microphone để nhận dạng giọng nói tiếng Việt."
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "ViSignAR cần camera để hiển thị ngôn ngữ ký hiệu trong AR.",
            "microphoneUsagePermission": "ViSignAR cần microphone để nhận dạng giọng nói tiếng Việt."
          },
          "android": {
            "xRMode": [
              "AR"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "745909d3-b0ec-4269-bd92-d438bec734c1"
      }
    },
    "owner": "dinhhiep68s-organization"
  }
}
